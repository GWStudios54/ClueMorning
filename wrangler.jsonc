{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clue-morning",
  "main": "src/worker-v4.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cluemorning.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/app.js",
      "/styles.css",
      "/sw.js",
      "/games/letter-grid/",
      "/games/four-groups/",
      "/games/letter-trail/",
      "/games/triple-link/",
      "/games/word-steps/",
      "/games/deep-cut/",
      "/games/tileworks/",
      "/games/pangram/",
      "/games/all-seven/",
      "/games/lineup/"
    ],
    "html_handling": "auto-trailing-slash"
  }
}
